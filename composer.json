{
    "name": "faustvik/yii2-audit-log",
    "description": "Audit log package for Yii2 with framework-agnostic core",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "yiisoft/yii2": "^2.0.51"
    },
    "require-dev": {
        "yidas/yii2-bower-asset": "*",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "FaustVik\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FaustVik\\AuditLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "rector": "rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "authors": [
        {
            "name": "Victor",
            "email": "victor.faust.dev@gmail.com"
        }
    ],
    "keywords": [
        "audit",
        "log",
        "logging",
        "yii2"
    ]
}
